PORT=3002

# Orca IT Facebook Page: https://www.facebook.com/profile.php?id=61593126667939
# Use the Graph API Page ID from Messenger API Settings (not the profile.php id)
FACEBOOK_PAGE_ID=1208194479052501
FACEBOOK_PAGE_NAME=Orcait

# Facebook App → Messenger → Webhooks
FACEBOOK_VERIFY_TOKEN=orcait-fb-webhook-verify
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=

# Human-like reply timing (milliseconds)
REPLY_DELAY_MS=5000
BETWEEN_MESSAGES_MS=1800

# Same SMTP as OrcaITWeb (staff notification when a Facebook booking completes)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@orcait.com.au
SMTP_PASS=
EMAIL_FROM=info@orcait.com.au
EMAIL_NOTIFY_TO=info@orcait.com.au

# Push completed bookings into CRM Manage Leads
CRM_INTERNAL_URL=http://localhost:3001
