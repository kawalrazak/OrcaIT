# Server port (use 80 only if you have permission, otherwise 3001 or 8080)
PORT=3001

# Keycloak SSO. The browser build reads the VITE_ values.
VITE_KEYCLOAK_URL=https://crm.orcait.com.au/auth
VITE_KEYCLOAK_REALM=orcait
VITE_KEYCLOAK_CLIENT_ID=orcait-crm
# Server-side Keycloak admin API. Inside Docker this is the compose service, not the public URL.
KEYCLOAK_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=orcait
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Set to production when deploying
NODE_ENV=production

# Twilio SMS (optional — leave blank and set TWILIO_MOCK_MODE=true to test without sending)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+61XXXXXXXXX

# Set true to simulate SMS without Twilio (good for demo/testing)
TWILIO_MOCK_MODE=false

# SMTP email (Send Invoice email from info@orcait.com.au)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@orcait.com.au
SMTP_PASS=your_email_password
SMTP_FROM=info@orcait.com.au
# Set true to simulate email without SMTP credentials
SMTP_MOCK_MODE=false

# Zeller Online Payments — Checkout Session (Send Invoice)
# Docs: https://developer.myzeller.com/ (account required)
# Webhook URL to register in Zeller: https://crm.orcait.com.au/api/zeller/webhook
ZELLER_API_BASE_URL=https://api.myzeller.com
ZELLER_CHECKOUT_PATH=/v1/checkout/sessions
ZELLER_API_KEY=
ZELLER_API_SECRET=
ZELLER_WEBHOOK_SECRET=
ZELLER_CURRENCY=AUD
# Zeller has no public server API for payment links yet. Leave this false.
# Invoices use a link copied from Zeller Dashboard → Virtual Terminal → Copy Link.
ZELLER_MOCK_MODE=false
# Where customers land after paying (orcait.com.au thank-you page)
ZELLER_SUCCESS_URL=https://orcait.com.au/thank-you
ZELLER_CANCEL_URL=https://orcait.com.au/
